#!/usr/bin/env bash
set -e
if [[ ! -d "/home/luuk/home/courses/year_3/Lab_on_offensive_computer_security/demo" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/home/luuk/home/courses/year_3/Lab_on_offensive_computer_security/demo")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/home/luuk/home/courses/year_3/Lab_on_offensive_computer_security/demo" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/home/luuk/home/courses/year_3/Lab_on_offensive_computer_security/demo/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/home/luuk/home/courses/year_3/Lab_on_offensive_computer_security/demo/.envrc" "/home/luuk/home/courses/year_3/Lab_on_offensive_computer_security/demo/.direnv"/*.rc
